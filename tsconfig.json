{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "preserveSymlinks": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
