{
  "name": "linkpm",
  "version": "1.0.8",
  "description": "Lightning-fast NPM package manager with directory links, central store, and stack presets",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "linkpm": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "linkpm.png",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "package-manager",
    "npm",
    "junctions",
    "symlinks",
    "presets",
    "cache",
    "fast",
    "scaffold",
    "mcp",
    "mcp-servers",
    "ai",
    "agent-skills"
  ],
  "author": "Dave",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "@types/tar": "^7.0.87",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
